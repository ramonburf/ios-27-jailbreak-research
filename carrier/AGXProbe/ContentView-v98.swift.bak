// AGXProbe v98 - private IOSurfaceRootUserClient connection
//
// Same goal as v96/v97 (drive the IOSurfaceRootUserClient notify methods over a
// PRIVATE IOServiceOpen()ed connection), but the shared-cache wrapper is now
// selected by matching the REAL function's prologue instead of by address.
//
// Why the address route failed:
//   The 27.0 runtime dyld cache lays its images out differently from the
//   27.0.1 (24A446) cache we analysed offline, so a slide-normalised static
//   address points at unrelated code.  Only the IOSurface image itself keeps
//   the same relative layout.  A BL instruction however is PC relative, so its
//   encoded immediate is slide invariant and can be decoded at runtime.
//
// Why several candidates appear:
//   The scan window can run past the end of the framework function into the
//   next one, which contains further calls to stubbed framework entry points.
//   All of them are 16-byte shared-cache thunks (adrp/add/br/brk#1) whose real
//   function starts with `pacibsp`, so we discriminate by the exact prologue
//   of the two functions we care about:
//
//     set    real fn:  pacibsp ; sub sp,sp,#0x80 ; stp x20,x19,[sp,#0x60] ;
//                        stp x29,x30,[sp,#0x70] ; add x29,sp,#0x70 ;
//                        mov x9,x7 ; mov x10,x2 ; mov x8,x1
//     remove real fn:  pacibsp ; sub sp,sp,#0x70 ; stp x20,x19,[sp,#0x50] ;
//                        stp x29,x30,[sp,#0x60] ; add x29,sp,#0x60 ;
//                        mov x9,x7 ; mov x8,x6 ; mov x10,x5
//
// Recovered ABI (from the framework call sites):
//
//   set(conn, 0x11, port, &in24, 3, 0, 0, &out24, 0x18, 0, 0, 0, 0)
//       x0 conn            x1 selector 0x11   x2 notify port
//       x3 &in24  = {0, type, surfaceID}      w4 = 3 (64-bit words)
//       x5 x6 = 0        x7 &out24 = {type, surfaceID, 0}
//       stack: 0x18 (out size), 0, 0, 0, 0
//
//   remove(conn, 0x12, 0, 0, &in24, 0x18, 0, 0, 0, 0)
//       x0 conn            x1 selector 0x12   x2 x3 = 0
//       x4 &in24 = {0, surfaceID, 0}         x5 = 0x18 (in size)
//       x6 x7 = 0
//       stack: 0, 0
//
// Runs on the 13 Pro only.

import SwiftUI
import Darwin
import Foundation
import CoreFoundation

@main
struct AGXProbeApp: App {
    var body: some Scene { WindowGroup { ContentView() } }
}

struct ContentView: View {
    @StateObject private var vm = ReachViewModel()
    var body: some View {
        VStack(spacing: 12) {
            Text("AGXProbe v98 - private IOSurface conn").font(.headline)
            ScrollView {
                Text(vm.log)
                    .font(.system(size: 9, design: .monospaced))
                    .foregroundColor(.green)
                    .frame(maxWidth: .infinity, alignment: .leading)
                    .padding(6).background(Color.black.opacity(0.85)).cornerRadius(6)
            }
            Button(action: { Task { await vm.runProbe() } }) {
                Text(vm.isRunning ? "Probing..." : "Run v98")
                    .font(.headline).foregroundColor(.white)
                    .frame(maxWidth: .infinity).padding(10)
                    .background(vm.isRunning ? Color.gray : Color.blue).cornerRadius(8)
            }.disabled(vm.isRunning)
            Text("Status: \(vm.status)").font(.caption2).foregroundColor(.secondary)
            Spacer(minLength: 0)
        }
        .padding().task { await vm.autoRunIfRequested() }
    }
}

@MainActor
final class ReachViewModel: ObservableObject {
    @Published var log = ""
    @Published var status = "Ready"
    @Published var isRunning = false
    private var didAutoRun = false

    private let logFileURL: URL = {
        FileManager.default.urls(for: .documentDirectory, in: .userDomainMask)[0]
            .appendingPathComponent("reach.log")
    }()

    private func emit(_ m: String) {
        log += m + "\n"; print(m); fflush(stdout)
        try? log.write(to: logFileURL, atomically: true, encoding: .utf8)
    }

    func autoRunIfRequested() async {
        guard !didAutoRun else { return }
        didAutoRun = true
        if ProcessInfo.processInfo.arguments.contains("--brotli") {
            emit("[br] CVE-2026-111497 repro, iOS " + ProcessInfo.processInfo.operatingSystemVersionString)
            let rc = BrotliRepro.run { self.emit($0) }
            emit("[br] rc=\(rc)")
            return
        }
        if ProcessInfo.processInfo.arguments.contains("--autorun") { await runProbe() }
    }

    // set(conn, sel, port, &in24, words, x5, x6, &out24, outSize, s1, s2, s3, s4)
    typealias SetWrap = @convention(c) (UInt32, UInt32, UInt64, UnsafeRawPointer?, UInt32,
                                        UInt64, UInt64, UnsafeRawPointer?,
                                        UInt64, UInt64, UInt64, UInt64, UInt64) -> Int32
    // remove(conn, sel, x2, x3, &in24, inSize, x6, x7, s0, s1)
    typealias RemWrap = @convention(c) (UInt32, UInt32, UInt64, UInt64, UnsafeRawPointer?,
                                        UInt64, UInt64, UInt64, UInt64, UInt64) -> Int32

    typealias SetNotifyFn = @convention(c) (mach_port_t, UInt64, UInt64) -> kern_return_t
    typealias RemoveNotifyFn = @convention(c) (UInt64) -> kern_return_t
    typealias CreateFn = @convention(c) (CFDictionary) -> UnsafeMutableRawPointer?
    typealias GetIDFn = @convention(c) (UnsafeMutableRawPointer) -> UInt32

    // ---- tiny arm64 helpers --------------------------------------------------
    func read32(_ addr: UInt64) -> UInt32? {
        guard let p = UnsafeRawPointer(bitPattern: Int(bitPattern: UInt(truncatingIfNeeded: addr))) else { return nil }
        let b = p.assumingMemoryBound(to: UInt8.self)
        return UInt32(b[0]) | (UInt32(b[1]) << 8) | (UInt32(b[2]) << 16) | (UInt32(b[3]) << 24)
    }
    func hexbytes(_ addr: UInt64, _ n: Int) -> String {
        guard let p = UnsafeRawPointer(bitPattern: Int(bitPattern: UInt(truncatingIfNeeded: addr))) else { return "?" }
        let b = p.assumingMemoryBound(to: UInt8.self)
        var s = ""
        for i in 0..<n { s += String(format: "%02x ", b[i]) }
        return s
    }
    // BL: target = pc + sign_extend(imm26) * 4
    func blTarget(_ word: UInt32, _ pc: UInt64) -> UInt64 {
        var imm = Int64(word & 0x03FFFFFF)
        if (imm & 0x02000000) != 0 { imm -= 0x04000000 }
        return UInt64(bitPattern: Int64(pc) &+ (imm &* 4))
    }
    // ADRP+ADD pair used by the shared-cache stub: target = page(adrp) + imm12(add)
    func stubTarget(_ adrp: UInt32, _ add: UInt32, _ pc: UInt64) -> UInt64 {
        let immhi = UInt64((adrp >> 5) & 0x7FFFF)
        let immlo = UInt64((adrp >> 29) & 0x3)
        var simm = Int64((immhi << 2) | immlo)
        if (simm & 0x100000) != 0 { simm -= 0x200000 }
        let page = (pc & ~UInt64(0xFFF)) &+ UInt64(bitPattern: simm &* 4096)
        let imm12 = UInt64((add >> 10) & 0xFFF)
        return page &+ imm12
    }
    func isADRP(_ w: UInt32) -> Bool { (w & 0x9F00001F) == 0x90000010 }
    func isADDimm(_ w: UInt32) -> Bool { (w & 0xFF80001F) == 0x91000010 }
    func isBRx16(_ w: UInt32) -> Bool { w == 0xD61F0200 }
    func isBRK1(_ w: UInt32) -> Bool { w == 0xD4200020 }
    func isPACIBSP(_ w: UInt32) -> Bool { w == 0xD503237F }

    struct WrapperCandidate {
        let stub: UInt64
        let real: UInt64
        let words: [UInt32]
    }

    /// Find every call inside `fnAddr` that targets a shared-cache stub whose
    /// real function starts with `pacibsp`.
    func findWrapperCalls(_ fnAddr: UInt64, _ span: Int) -> [WrapperCandidate] {
        var found: [WrapperCandidate] = []
        for off in stride(from: 0, to: span, by: 4) {
            guard let w = read32(fnAddr &+ UInt64(off)) else { continue }
            guard (w & 0xFC000000) == 0x94000000 else { continue }   // BL
            let stub = blTarget(w, fnAddr &+ UInt64(off))
            guard let w0 = read32(stub), let w1 = read32(stub &+ 4),
                  let w2 = read32(stub &+ 8), let w3 = read32(stub &+ 12) else { continue }
            guard isADRP(w0), isADDimm(w1), isBRx16(w2), isBRK1(w3) else { continue }
            let real = stubTarget(w0, w1, stub)
            guard let r0 = read32(real), isPACIBSP(r0) else { continue }
            var ws: [UInt32] = []
            for i in 0..<8 {
                if let x = read32(real &+ UInt64(i * 4)) { ws.append(x) } else { break }
            }
            found.append(WrapperCandidate(stub: stub, real: real, words: ws))
        }
        return found
    }

    func matchesPrologue(_ c: WrapperCandidate, _ expected: [UInt32]) -> Bool {
        guard c.words.count >= expected.count else { return false }
        for i in 0..<expected.count {
            if c.words[i] != expected[i] { return false }
        }
        return true
    }

    func dumpCandidates(_ label: String, _ cands: [WrapperCandidate]) {
        emit("  [\(label)] \(cands.count) stub candidate(s)")
        for (i, c) in cands.enumerated() {
            var ws = ""
            for w in c.words { ws += String(format: "%08X ", w) }
            emit("   #\(i) stub=0x\(String(c.stub, radix: 16)) real=0x\(String(c.real, radix: 16))")
            emit("       stub bytes = \(hexbytes(c.stub, 16))")
            emit("       real words = \(ws)")
        }
    }

    func runProbe() async {
        isRunning = true; status = "Probing..."; log = ""
        try? "".write(to: logFileURL, atomically: true, encoding: .utf8)
        emit("=== AGXProbe v98 - private IOSurfaceRootUserClient ===")
        try? await Task.sleep(nanoseconds: 2_000_000_000)

        guard let fwH = dlopen("/System/Library/Frameworks/IOSurface.framework/IOSurface", RTLD_NOW),
              let setSym = dlsym(fwH, "IOSurfaceClientSetSurfaceNotify"),
              let remSym = dlsym(fwH, "IOSurfaceClientRemoveSurfaceNotify"),
              let createSym = dlsym(fwH, "IOSurfaceCreate"),
              let getIdSym = dlsym(fwH, "IOSurfaceGetID") else {
            emit("[-] dlsym fail"); status = "Complete"; isRunning = false; return
        }
        let gSet = unsafeBitCast(setSym, to: SetNotifyFn.self)
        let gRemove = unsafeBitCast(remSym, to: RemoveNotifyFn.self)
        let gCreate = unsafeBitCast(createSym, to: CreateFn.self)
        let gGetID = unsafeBitCast(getIdSym, to: GetIDFn.self)

        func krName(_ kr: Int32) -> String {
            switch kr {
            case KERN_SUCCESS: return "OK"
            case Int32(bitPattern: 0xe00002bd): return "NoMemory"
            case Int32(bitPattern: 0xe00002c2): return "BadArgument"
            case Int32(bitPattern: 0xe00002c9): return "Duplicate/Exists"
            case Int32(bitPattern: 0xe00002d8): return "NotAttached(27.2 guard)"
            default: return String(format: "0x%08x", UInt32(bitPattern: kr))
            }
        }
        func makeSurface(w: Int, h: Int) -> UnsafeMutableRawPointer? {
            var keyCB = kCFTypeDictionaryKeyCallBacks
            var valCB = kCFTypeDictionaryValueCallBacks
            let props = CFDictionaryCreateMutable(nil, 0, &keyCB, &valCB) as! NSMutableDictionary
            props["IOSurfaceWidth"] = w
            props["IOSurfaceHeight"] = h
            props["IOSurfaceBytesPerElement"] = 4
            return gCreate(props)
        }

        // ---- 1. locate the wrappers at runtime --------------------------------
        emit("\n=== 1. runtime wrapper discovery ===")
        var infoIOS = Dl_info()
        var infoIOR = Dl_info()
        _ = dladdr(setSym, &infoIOS)
        _ = dladdr(remSym, &infoIOR)
        guard infoIOS.dli_saddr != nil, infoIOR.dli_saddr != nil else {
            emit("[-] dladdr failed"); status = "Complete"; isRunning = false; return
        }
        let setFn = unsafeBitCast(infoIOS.dli_saddr!, to: UInt64.self)
        let remFn = unsafeBitCast(infoIOR.dli_saddr!, to: UInt64.self)
        emit("IOSurface image base = 0x\(String(unsafeBitCast(infoIOS.dli_fbase!, to: UInt64.self), radix: 16))")
        emit("set_notify   runtime = 0x\(String(setFn, radix: 16))")
        emit("remove_notify runtime = 0x\(String(remFn, radix: 16))")
        emit("set_notify   bytes  = \(hexbytes(setFn, 16))")
        emit("remove_notify bytes  = \(hexbytes(remFn, 16))")

        // expected real-function prologues (recovered from the 27.0.1 cache)
        let setPrologue: [UInt32] = [0xD503237F, 0xD10203FF, 0xA9064FF4, 0xA9077BFD,
                                     0x9101C3FD, 0xAA0703E9, 0xAA0203EA, 0xAA0103E8]
        let remPrologue: [UInt32] = [0xD503237F, 0xD101C3FF, 0xA9054FF4, 0xA9067BFD,
                                     0x910183FD, 0xAA0703E9, 0xAA0603E8, 0xAA0503EA]

        let setCands = findWrapperCalls(setFn, 0x120)
        let remCands = findWrapperCalls(remFn, 0x120)
        dumpCandidates("set", setCands)
        dumpCandidates("remove", remCands)

        var setHits = setCands.filter { matchesPrologue($0, setPrologue) }
        var remHits = remCands.filter { matchesPrologue($0, remPrologue) }
        if setHits.isEmpty {
            // loose fallback: pacibsp + matching frame size
            setHits = setCands.filter { c in c.words.count >= 2 && c.words[0] == 0xD503237F && c.words[1] == 0xD10203FF }
        }
        if remHits.isEmpty {
            remHits = remCands.filter { c in c.words.count >= 2 && c.words[0] == 0xD503237F && c.words[1] == 0xD101C3FF }
        }
        emit("set matches=\(setHits.count)  remove matches=\(remHits.count)")
        guard setHits.count >= 1, remHits.count >= 1 else {
            emit("[-] could not identify the wrappers - aborting before any call")
            status = "Complete"; isRunning = false; return
        }
        let setWrapAddr = setHits[0].stub
        let remWrapAddr = remHits[0].stub
        emit("set wrapper   stub  = 0x\(String(setWrapAddr, radix: 16))  -> real 0x\(String(setHits[0].real, radix: 16))")
        emit("               bytes = \(hexbytes(setWrapAddr, 16))")
        emit("remove wrapper stub  = 0x\(String(remWrapAddr, radix: 16))  -> real 0x\(String(remHits[0].real, radix: 16))")
        emit("               bytes = \(hexbytes(remWrapAddr, 16))")

        // ---- 2. open our own IOSurfaceRootUserClient --------------------------
        emit("\n=== 2. open private IOSurfaceRootUserClient ===")
        var iter: io_iterator_t = 0
        let matchName = "IOSurfaceRoot"
        // NOTE: the matching port must be 0 (default IOKit master port); passing
        // mach_task_self() here makes the kernel reject the call.
        var kr: Int32 = matchName.withCString {
            xq_IOServiceGetMatchingServices(0, xq_IOServiceMatching($0), &iter)
        }
        emit("IOServiceGetMatchingServices -> \(krName(kr)) iter=0x\(String(iter, radix: 16))")
        guard kr == KERN_SUCCESS else { status = "Complete"; isRunning = false; return }
        let svc = xq_IOIteratorNext(iter)
        emit("service = 0x\(String(svc, radix: 16))")
        var conn: io_connect_t = 0
        kr = xq_IOServiceOpen(svc, mach_task_self(), 0, &conn)
        emit("IOServiceOpen -> \(krName(kr)) conn=0x\(String(conn, radix: 16))")
        guard kr == KERN_SUCCESS else { status = "Complete"; isRunning = false; return }

        // ---- 3. notify port ----------------------------------------------------
        var port: mach_port_t = 0
        kr = mach_port_allocate(mach_task_self(), MACH_PORT_RIGHT_RECEIVE, &port)
        emit("notify port 0x\(String(port, radix: 16)) kr=\(krName(kr))")
        guard kr == KERN_SUCCESS else { status = "Complete"; isRunning = false; return }

        // ---- 4. control: shared connection ------------------------------------
        emit("\n=== 4. control - shared connection (public API) ===")
        guard let s0 = makeSurface(w: 64, h: 64) else {
            emit("[-] create failed"); status = "Complete"; isRunning = false; return
        }
        let id0 = gGetID(s0)
        emit("[shared] surface id 0x\(String(id0, radix: 16))")
        emit("[shared] set(port,1,id) -> \(krName(gSet(port, 1, UInt64(id0))))")
        emit("[shared] remove(id)   -> \(krName(gRemove(UInt64(id0))))")
        Unmanaged<AnyObject>.fromOpaque(s0).release()

        // ---- 5. private connection: set / remove ------------------------------
        emit("\n=== 5. private connection - set/remove via shared-cache wrapper ===")
        guard let s1 = makeSurface(w: 80, h: 80) else {
            emit("[-] create failed"); status = "Complete"; isRunning = false; return
        }
        let id1 = gGetID(s1)
        emit("[priv] surface id 0x\(String(id1, radix: 16))")

        let setWrap = unsafeBitCast(setWrapAddr, to: SetWrap.self)
        let remWrap = unsafeBitCast(remWrapAddr, to: RemWrap.self)

        // framework layout: in24 = {0, type, surfaceID}, out24 = {type, surfaceID, 0}
        var inSet: (UInt64, UInt64, UInt64) = (0, 1, UInt64(id1))
        var outSet: (UInt64, UInt64, UInt64) = (1, UInt64(id1), 0)
        let krSet: Int32 = withUnsafePointer(to: &inSet) { ip in
            withUnsafePointer(to: &outSet) { op in
                setWrap(conn, 0x11, UInt64(port), UnsafeRawPointer(ip), 3, 0, 0,
                        UnsafeRawPointer(op), 0x18, 0, 0, 0, 0)
            }
        }
        emit("[priv] set wrapper   -> \(krName(krSet))   out=(\(outSet.0),\(outSet.1),\(outSet.2))")

        // remove layout: in24 = {0, surfaceID, 0}
        var inRem: (UInt64, UInt64, UInt64) = (0, UInt64(id1), 0)
        let krRem: Int32 = withUnsafePointer(to: &inRem) { ip in
            remWrap(conn, 0x12, 0, 0, UnsafeRawPointer(ip), 0x18, 0, 0, 0, 0)
        }
        emit("[priv] remove wrapper -> \(krName(krRem))")

        let krRem2: Int32 = withUnsafePointer(to: &inRem) { ip in
            remWrap(conn, 0x12, 0, 0, UnsafeRawPointer(ip), 0x18, 0, 0, 0, 0)
        }
        emit("[priv] remove again   -> \(krName(krRem2))  (BadArgument == nothing was registered)")

        // ---- 6. cross-check: the shared connection must NOT see it -----------
        emit("\n=== 6. cross-check ===")
        emit("[shared] remove(id1) on the private-registered id -> \(krName(gRemove(UInt64(id1))))")
        emit("[shared] set(port,1,id1) -> \(krName(gSet(port, 1, UInt64(id1))))")
        emit("[shared] remove(id1)    -> \(krName(gRemove(UInt64(id1))))")

        Unmanaged<AnyObject>.fromOpaque(s1).release()
        _ = xq_IOServiceClose(conn)
        emit("\n[priv] connection closed")
        emit("\n=== done ===")
        status = "Complete"; isRunning = false
    }
}

// mach_task_self is not exposed by the Darwin module on iOS
@_silgen_name("mach_task_self")
func mach_task_self() -> mach_port_t

